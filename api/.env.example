PORT=3001
# Use the domain of your live forum. Comma-separate for local testing.
ALLOWED_ORIGINS=https://forum.adamisbored.xyz
# Do not enable until Firebase security rules and server moderation are ready.
ENABLE_WRITES=false
# Optional: comma-separated Firebase Auth UIDs, not usernames.
ADMIN_UIDS=
# Keep service-account JSON OUT of git; set GOOGLE_APPLICATION_CREDENTIALS to its absolute path.
GOOGLE_APPLICATION_CREDENTIALS=/home/forumapi/secrets/firebase-service-account.json

# Trusted HTTPS moderation service returning JSON {"approved": true|false}
# Keep the key on the VPS; never expose it to the browser or GitHub.
MODERATION_URL=
MODERATION_API_KEY=

# Reuse the existing Xenova/toxic-bert model locally on the VPS.
# This loads model weights on first use; test memory and startup time on staging.
MODERATION_PROVIDER=local-toxic-bert
